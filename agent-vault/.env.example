# Copy this file to .env and replace every example value before use.
# Use a trusted Ethereum Sepolia RPC endpoint. Public RPCs may rate-limit requests.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Generate a long random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-long-random-secret-before-use

# Comma-separated addresses this app may send to. Replace with your own Sepolia test recipient.
ALLOWED_RECIPIENTS=0x1111111111111111111111111111111111111111
# Keep false. true allows any valid recipient and weakens the primary safety guardrail.
ALLOW_ANY_RECIPIENT=false

MAX_TX_ETH=0.02
DAILY_LIMIT_ETH=0.05
MAX_FEE_ETH=0.001
MAX_GAS_LIMIT=50000
PROPOSAL_TTL_SECONDS=300
SESSION_TTL_SECONDS=28800

# Optional. Without this, Claude-generated explanations use a clearly labelled local fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
VITE_API_URL=http://localhost:8000
